# Public URL of the app (used in emails, Stripe redirects, hosted page and banner URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER_MONTHLY=price_xxx
STRIPE_PRICE_STARTER_YEARLY=price_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx
# Optional: free trial length in days (0 = no trial)
STRIPE_TRIAL_DAYS=7
# Optional: let Stripe Tax compute EU VAT (needs Stripe Tax enabled, +0.5% per transaction)
STRIPE_AUTOMATIC_TAX=false
